{
  ///////////////////////////////////////////
  ///               Code Runner           ///
  ///////////////////////////////////////////
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "code-runner.saveAllFilesBeforeRun": true,
  ///////////////////////////////////////////
  ///               Python                ///
  ///////////////////////////////////////////
  "python.autoComplete.addBrackets": true,
  "python.analysis.completeFunctionParens": true,
  "python.pythonPath": "/usr/bin/python3",
  "python.defaultInterpreterPath": "/usr/bin/python3",
  "code-runner.executorMap": {
    "python": "/usr/bin/python3"
  },
  "python.linting.enabled": true,
  "python.linting.lintOnSave": true,
  ///////////////////////////////////////////
  ///               Editor                ///
  ///////////////////////////////////////////
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },
  "editor.suggestSelection": "first",
  "editor.suggest.localityBonus": true,
  "editor.inlineSuggest.enabled": true,
  "editor.parameterHints.enabled": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.wordBasedSuggestions": "matchingDocuments",
  "files.autoSave": "onFocusChange",
  //"vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "breadcrumbs.enabled": true,
  "editor.fontFamily": "Iosevka",
  "editor.fontLigatures": true,
  "editor.fontSize": 13,
  "editor.tabSize": 2,
  "editor.renderControlCharacters": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.quickSuggestionsDelay": 0,
  "editor.suggest.preview": false,
  "editor.suggest.shareSuggestSelections": true,
  "editor.guides.bracketPairs": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.tabCompletion": "on",
  "editor.formatOnType": true,
  "editor.minimap.autohide": "mouseover",
  "editor.acceptSuggestionOnEnter": "smart",
  //"editor.inlayHints.fontFamily": "'Cascadia Mono', 'monospace', monospace, 'Droid Sans Fallback'",
  ///////////////////////////////////////////
  ///             Workbench               ///
  ///////////////////////////////////////////
  "workbench.editor.enablePreview": false,
  "workbench.list.smoothScrolling": true,
  "workbench.colorTheme": "Atom One Dark",
  "oneDarkPro.editorTheme": "oneDarkPro",
  "workbench.startupEditor": "none",
  // "material-icon-theme.activeIconPack": "react",
  "material-icon-theme.activeIconPack": "react_redux",
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook"
  },
  ///////////////////////////////////////////
  ///             Terminal                ///
  ///////////////////////////////////////////
  "terminal.external.linuxExec": "kitty",
  "terminal.integrated.bellDuration": 0,
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontFamily": "Hack Nerd Font Mono",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.allowChords": false,
  // "terminal.external.osxExec": "iTerm.app",
  ///////////////////////////////////////////
  ///             Explorer                ///
  ///////////////////////////////////////////
  "explorer.confirmDragAndDrop": false,
  ///////////////////////////////////////////
  ///             Prettier                ///
  ///////////////////////////////////////////
  "prettier.requireConfig": true,
  "prettier.useTabs": true,
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "left"
  },
  ///////////////////////////////////////////
  ///             Spellright              ///
  ///////////////////////////////////////////
  "spellright.addToSystemDictionary": true,
  "spellright.documentTypes": [
    "markdown",
    "latex",
    "plaintext"
  ],
  "redhat.telemetry.enabled": false,
  "vs-kubernetes": {
    "vscode-kubernetes.helm-path.linux": "/home/vegard/.vs-kubernetes/tools/helm/linux-amd64/helm",
    "vscode-kubernetes.minikube-path.linux": "/home/vegard/.vs-kubernetes/tools/minikube/linux-amd64/minikube",
    "vs-kubernetes.crd-code-completion": "enabled",
    "vscode-kubernetes.helm-path.mac": "/Users/vegard/.vs-kubernetes/tools/helm/darwin-arm64/helm",
    "vscode-kubernetes.minikube-path.mac": "/Users/vegard/.vs-kubernetes/tools/minikube/darwin-arm64/minikube"
  },
  ///////////////////////////////////////////
  ///             VSCode Vim              ///
  ///////////////////////////////////////////
  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": false,
  "vim.hlsearch": true,
  "vim.insertModeKeyBindings": [
    {
      "before": [
        "j",
        "j"
      ],
      "after": [
        "<Esc>"
      ]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<leader>",
        "d"
      ],
      "after": [
        "d",
        "d"
      ]
    },
    {
      "before": [
        "<C-n>"
      ],
      "commands": [
        ":nohl"
      ]
    }
  ],
  "vim.leader": "<space>",
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false
  },
  ///////////////////////////////////////////
  ///             Markdown                ///
  ///////////////////////////////////////////
  "markdownlint.config": {
    "MD032": false
  },
  ///////////////////////////////////////////
  ///             golang                  ///
  ///////////////////////////////////////////
  "[go]": {
    "editor.formatOnSave": true
  },
  ///////////////////////////////////////////
  ///             Others/Misc             ///
  ///////////////////////////////////////////
  "bracket-pair-colorizer-2.depreciation-notice": false,
  "workbench.tree.indent": 6,
  "javascript.inlayHints.functionLikeReturnTypes.enabled": true,
  "javascript.inlayHints.enumMemberValues.enabled": true,
  "azureFunctions.showProjectWarning": false,
  "lldb.library": "/Library/Developer/CommandLineTools/Library/PrivateFrameworks/LLDB.framework/Versions/A/LLDB",
  "workbench.preferredDarkColorTheme": "Atom One Dark",
  "workbench.fontAliasing": "auto",
  "workbench.iconTheme": "material-icon-theme",
  "vscode_custom_css.imports": [
    ""
  ],
  "explorer.experimental.fileNesting.enabled": true,
  "go.enableCodeLens": {
    "references": true
  },
  "go.autocompleteUnimportedPackages": true,
  "go.toolsManagement.autoUpdate": true,
  "git.mergeEditor": true,
  "mergeEditor.diffAlgorithm": "smart",
  "window.commandCenter": false,
  "githubPullRequests.pullBranch": "never",
  "window.autoDetectColorScheme": true,
  "workbench.preferredLightColorTheme": "Atom One Light",
  "terminal.external.osxExec": "kitty.app",
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "window.closeWhenEmpty": true,
  "window.titleSeparator": " —",
  "explorer.fileNesting.enabled": true,
  "workbench.view.alwaysShowHeaderActions": true,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.wrapTabs": false,
  "keyboard.touchbar.enabled": false,
  ///////////////////////////////////////////
  ///             Theme                   ///
  ///////////////////////////////////////////
  "editor.tokenColorCustomizations": {
    // "comments": "",
    // "variables": "#FF7043",
    // "functions": "#00BCD4",
    // "types": "#FFEE58",
    // "strings": "#9CCC65",
    // "textMateRules": [],
    // "keywords": "#AB47BC",
    // "numbers": "",
  },
  "workbench.colorCustomizations": {
    // "activityBar.activeBackground": "#bba4a4",
    // "editor.background": "#212121",
    // "editor.foreground": "#ff0000",
    // "editor.findMatchHighlightBackground": "#ff0000",
    // "textBlockQuote.background": "#ff0000",
    // "focusBorder": "#ff0000",
  },
  "explorer.confirmDelete": false,
  "azure.resourceFilter": [
    "2dfb2f0b-4d21-4268-9559-72926144c918/5b17a884-c7c6-497d-b667-0e0e67c74b7b"
  ],
  "[azure-pipelines]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.associations": {
    "**/.azuredevops/**/*.yml": "azure-pipelines",
    "*.yml": "azure-pipelines"
  },
  "[python]": {
    "editor.formatOnType": true
  },
  "extensions.autoUpdate": "onlyEnabledExtensions",
  "workbench.activityBar.location": "top",
  "go.inlayHints.parameterNames": true,
  "window.customTitleBarVisibility": "auto",
  "geminicodeassist.project": "sharp-genre-bfbhg",
}